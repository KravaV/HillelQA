{
	"info": {
		"_postman_id": "a6d29f9d-e0a7-445a-aca0-1991aa62e52d",
		"name": "hw18.1 SOAP",
		"description": "This is a collection of different SOAP APIs that are completley public and do not require any authentication, making it easier for consumers to play with and understand what APIs are all about by seeing the many different ways in which APIs can be used.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "39485066"
	},
	"item": [
		{
			"name": "Is Valid ISBN10 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let jsonData = xml2Json(pm.response.text());",
							"let body = pm.response.text();",
							"",
							"pm.test(\"Request body contains intended ISBN\", () => {",
							"  pm.expect(pm.request.body.toString()).to.include(\"0-19-852663-6\"); ",
							"});",
							"",
							"pm.test(\"Envelope has Body object\", () => {",
							"    pm.expect(jsonData[\"soap:Envelope\"]).to.have.property(\"soap:Body\");",
							"});",
							"",
							"pm.test(\"Body is not empty\", () => {",
							"    let b = jsonData[\"soap:Envelope\"][\"soap:Body\"];",
							"    pm.expect(Object.keys(b).length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Body contains IsValidISBN10Response tag\", () => {",
							"  pm.expect(pm.response.text()).to.include(\"IsValidISBN10Response\");",
							"});",
							"",
							"pm.test(\"Response has closing Envelope tag\", () => {",
							"  const body = pm.response.text().trim();",
							"  pm.expect(body.endsWith(\"</soap:Envelope>\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Server header present\", () => {",
							"    pm.expect(pm.response.headers.has(\"Server\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Date header present\", () => {",
							"    pm.expect(pm.response.headers.has(\"Date\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Response starts with XML declaration\", () => {",
							"    pm.expect(body.startsWith(\"<?xml\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Response time < 2s\", () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"pm.test(\"Response keyword present\", () => {",
							"    pm.expect(body).to.include(\"Response\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN10 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>0-19-852663-6</sISBN>\n    </IsValidISBN10>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				},
				"description": "The test is done by calculation on the first 9 digits and compare the result with the checksum number at the end. You have to pass a 10 digits number or 8 digits and an X."
			},
			"response": []
		},
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let data = xml2Json(pm.response.text());",
							"",
							"let envelope = data[\"soap:Envelope\"];",
							"let body = envelope[\"soap:Body\"];",
							"",
							"let respKey = Object.keys(body).find(k => k.endsWith(\"IsValidISBN13Response\"));",
							"let respObj = body[respKey];",
							"",
							"let resultKey = Object.keys(respObj).find(k => k.endsWith(\"IsValidISBN13Result\"));",
							"let resultVal = String(respObj[resultKey]).trim().toLowerCase();",
							"",
							"pm.test(\"Has Envelope\", () => {",
							"  pm.expect(envelope).to.exist;",
							"});",
							"",
							"pm.test(\"Has Body\", () => {",
							"  pm.expect(body).to.exist;",
							"});",
							"",
							"pm.test(\"Has IsValidISBN13Response\", () => {",
							"  pm.expect(respKey).to.exist;",
							"});",
							"",
							"pm.test(\"Has IsValidISBN13Result\", () => {",
							"  pm.expect(resultKey).to.exist;",
							"});",
							"",
							"pm.test(\"Result not empty\", () => {",
							"  pm.expect(resultVal.length).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Result is boolean text\", () => {",
							"  pm.expect([\"true\",\"false\"]).to.include(resultVal);",
							"});",
							"",
							"pm.test(\"Status is 200\", () => {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content-Type header has xml/soap\", () => {",
							"  let ct = (pm.response.headers.get(\"Content-Type\") || \"\").toLowerCase();",
							"  pm.expect(ct).to.satisfy(v => v.includes(\"xml\") || v.includes(\"soap\"));",
							"});",
							"",
							"pm.test(\"Response time < 3s\", () => {",
							"  pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});",
							"",
							"pm.test(\"No SOAP Fault present\", () => {",
							"  pm.expect(pm.response.text()).to.not.include(\"<Fault>\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				},
				"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
			},
			"response": []
		}
	],
