		{
			"name": "LIMIT REQUEST",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"const data = pm.response.json();",
							"",
							"pm.test(\"Відповідь є масивом\", function () {",
							"  pm.expect(Array.isArray(data)).to.be.true;",
							"});",
							"",
							"pm.test(\"Масив має не більше 5 елементів (limit=5)\", function () {",
							"  pm.expect(data.length).to.be.at.most(5);",
							"});",
							"",
							"pm.test(\"Кожен документ має поле _id\", function () {",
							"  if (data.length > 0) {",
							"    data.forEach(d => pm.expect(d).to.have.property(\"_id\"));",
							"  }",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
