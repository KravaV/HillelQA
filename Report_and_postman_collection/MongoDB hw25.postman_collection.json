			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
							"const arr = pm.response.json();",
							"pm.test(\"Масив результатів\", () => pm.expect(Array.isArray(arr)).to.be.true);",
							"if (arr.length) {",
							"  pm.test(\"Кожен має _id\", () => arr.forEach(d => pm.expect(d).to.have.property(\"_id\")));",
							"  pm.test(\"Фільтр спрацював (country=United States)\", () => ",
							"    arr.forEach(d => pm.expect(d.address?.country).to.eql(\"United States\"))",
							"  );",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
